[{"_id": "hush_pipeline_movie_1080_master_v1", "name": "HUSH Movie 1080p Master", "description": "Master encode (SHR), the quality work. Audio gate first (original language as default, Opus plus EAC3 compat). The grain gate (hush_grain_gate_hevc.py) probes HEVC CQ20 at 25/50/75% of the runtime: when that costs no more than 10 Mbps the title is clean and encodes HEVC NVENC CQ20 with a 14M cap, otherwise HEVC VBR 10M (14M peak). Both 10-bit, p7, multipass; resize above 1920 width; HDR signaling kept. AV1 CQ22 was the clean path until 2026-11-01: AV1 transcoded for client support on 28% of Plex plays against 4% for HEVC, and the old AV1 probe called nearly every source grainy. The AV1 nodes remain only for the router's av1 queue handle, which no library feeds. A Dolby Vision source is re-encoded like any other: the RPU is dropped and the HDR10 base layer stays (Jordan 2026-11-09: DV is not worth keeping). Profile 5 (no HDR10 base) stops the job at the grain gate.", "tags": "", "flowPlugins": [{"name": "Input", "sourceRepo": "Community", "pluginName": "inputFile", "version": "1.0.0", "inputsDB": {"fileAccessChecks": "true", "pauseNodeIfAccessChecksFail": "true"}, "fpEnabled": true, "id": "input_node", "position": {"x": 600, "y": -1200}}, {"name": "Check File Size (Skip tiny samples)", "sourceRepo": "Community", "pluginName": "checkFileSize", "version": "1.0.0", "inputsDB": {"unit": "MB", "lessThan": "50"}, "fpEnabled": true, "id": "size_check", "position": {"x": 600, "y": -1100}}, {"id": "grain_gate", "name": "HUSH Grain Gate", "version": "1.0.0", "sourceRepo": "Local", "pluginName": "HushGate", "fpEnabled": true, "position": {"x": 600, "y": -800}, "inputsDB": {"scriptPath": "/app/scripts/hush_grain_gate_hevc.py"}}, {"id": "multi_queue_router", "name": "Check Queue (Smart Router)", "version": "1.0.0", "sourceRepo": "Local", "pluginName": "HushMultiQueueRouter", "inputsDB": {"sig_audio": "audio_1080p", "sig_av1": "av1_1080p", "sig_hevc": "hevc_1080p"}, "fpEnabled": true, "position": {"x": 600, "y": -900}}, {"name": "Start (AV1 queue)", "sourceRepo": "Community", "pluginName": "ffmpegCommandStart", "version": "1.0.0", "fpEnabled": true, "id": "start_av1", "position": {"x": 400, "y": -650}}, {"name": "Enc: AV1 (NVENC CQ22)", "sourceRepo": "Community", "pluginName": "ffmpegCommandSetVideoEncoder", "version": "1.0.0", "inputsDB": {"hardwareType": "nvenc", "outputCodec": "av1", "ffmpegPreset": "veryslow", "ffmpegQuality": "22", "ffmpegQualityEnabled": "true", "ffmpegPresetEnabled": "false"}, "fpEnabled": true, "id": "enc_av1", "position": {"x": 400, "y": -550}}, {"name": "AV1 Opts (10-bit P7)", "sourceRepo": "Community", "pluginName": "ffmpegCommandCustomArguments", "version": "1.0.0", "inputsDB": {"outputArguments": "-pix_fmt p010le -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -multipass 2 -bf 5 -preset p7"}, "fpEnabled": true, "id": "av1_opts", "position": {"x": 400, "y": -450}}, {"name": "Start (Grainy)", "sourceRepo": "Community", "pluginName": "ffmpegCommandStart", "version": "1.0.0", "fpEnabled": true, "id": "start_hevc", "position": {"x": 800, "y": -650}}, {"name": "Enc: HEVC (NVENC VBR)", "sourceRepo": "Community", "pluginName": "ffmpegCommandSetVideoEncoder", "version": "1.0.0", "inputsDB": {"hardwareType": "nvenc", "outputCodec": "hevc", "ffmpegPreset": "veryslow", "ffmpegQualityEnabled": "false", "ffmpegPresetEnabled": "false"}, "fpEnabled": true, "id": "enc_hevc", "position": {"x": 800, "y": -550}}, {"name": "HEVC Opts (10M Target)", "sourceRepo": "Community", "pluginName": "ffmpegCommandCustomArguments", "version": "1.0.0", "inputsDB": {"outputArguments": "-rc vbr -b:v 10M -maxrate 14M -bufsize 28M -pix_fmt p010le -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -multipass 2 -tag:v hvc1 -preset p7"}, "fpEnabled": true, "id": "hevc_opts", "position": {"x": 800, "y": -450}}, {"name": "Resize (Targeted)", "sourceRepo": "Community", "pluginName": "ffmpegCommandCustomArguments", "version": "1.0.0", "inputsDB": {"outputArguments": 