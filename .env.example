# Singularr settings. Copy to .env and fill in. docs/configuration.md describes every setting.
# An empty value counts as unset: an integration without its key is skipped with a warning.

# Database (docker-compose.yml runs PostgreSQL 18 and builds DATABASE_URL from this password)
POSTGRES_PASSWORD=

# Search (docker-compose.yml runs Meilisearch with this master key and gives it to Singularr as
# SINGULARR_SEARCH_KEY). At least 16 characters: openssl rand -hex 32
MEILI_MASTER_KEY=

# Who is the owner, and how the owner signs in (README, "Sign-in")
SINGULARR_OWNER_EMAILS=you@example.org
# The address your sign-in proxy connects from, as Singularr sees it (for a proxy container on the
# same Docker network: that container's address). Unset, no identity header is trusted.
SINGULARR_TRUSTED_PROXY_IPS=
SINGULARR_EDGE_TOKEN=
SINGULARR_SIGN_OUT_URL=

# Addresses people use
SINGULARR_OWNER_URL=https://singularr.example.org
SINGULARR_REQUESTS_PUBLIC_URL=https://requests.example.org

# Integrations: each one is read only until you allow it to act in Settings, Integrations
PLEX_URL=http://plex:32400
PLEX_TOKEN=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
QBIT_URL=
QBIT_USER=
QBIT_PASS=
SEERR_URL=
SEERR_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=
TDARR_URL=
TDARR_API_KEY=

# Metadata (optional, but titles and people are richer with them)
SINGULARR_TMDB_TOKEN=
SINGULARR_TVDB_KEY=

# Singularr Requests (only with: docker compose --profile requests up -d). Singularr creates the
# portal's database role with this password. Letters and digits only: it goes into a database
# address as it is (openssl rand -hex 32).
SINGULARR_REQUESTS_DB_PASSWORD=
SINGULARR_REQUESTS_SESSION_SECRET=

# Ports and time zone
SINGULARR_PORT=7300
SINGULARR_REQUESTS_PORT=7302
TZ=UTC
